{
  "name": "elide",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsc -p tsconfig.extension.json && node scripts/package-extension.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "typecheck": "tsc -b --pretty false",
    "deploy:vercel": "vercel --prod --yes"
  },
  "dependencies": {
    "firebase": "^12.6.0",
    "motion": "^12.23.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/chrome": "^0.0.331",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "firebase-tools": "^14.17.0",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
